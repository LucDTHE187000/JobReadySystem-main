# Database
MONGO_URI=

# Server Configuration
PORT=4000

# JWT Secret (thay đổi trong production, tối thiểu 32 ký tự)
JWT_SECRET=
# JWT Expiration ( Để nguyên không cần thay đổi )
JWT_EXPIRES_IN=7d

# PayOS Configuration
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
BASE_URL=

# Email Configuration (for OTP - Resend API)
RESEND_API_KEY=
RESEND_SENDER=onboarding@resend.dev
# EMAIL_DEV_MODE=true

# Groq API - Lấy key miễn phí tại https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini API - Lấy key miễn phí tại https://aistudio.google.com/apikey
# Dùng làm fallback thay thế khi Groq chậm hoặc sinh câu hỏi trùng
GEMINI_API_KEY=
# Google Client ID (for Google Login)
GOOGLE_CLIENT_ID=
